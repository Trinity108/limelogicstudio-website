# Cloudflare Pages custom headers
# Fonts, images, and video are content-stable — cache hard at the edge and in browsers.
# CSS/JS are un-fingerprinted, so cap them at a day to keep deploys visible.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=86400

/js/*
  Cache-Control: public, max-age=86400
